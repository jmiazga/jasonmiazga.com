---
// Posts live at the site root (/digital-garden/), same as the Gatsby site.
import { getCollection, render } from "astro:content"
import Blog from "../layouts/Blog.astro"
import Bio from "../components/Bio.astro"
import { formatDate } from "../site"

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  )
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }))
}

const { post, newer, older } = Astro.props
const { Content } = await render(post)
---

<Blog title={post.data.title} description={post.data.description || undefined}>
  <article>
    <header>
      <h1 style="margin-top: 1.75rem; margin-bottom: 0">{post.data.title}</h1>
      <p style="font-size: 0.83255rem; line-height: 1.75rem; margin-bottom: 1.75rem">
        {formatDate(post.data.date)}
      </p>
    </header>
    <section>
      <Content />
    </section>
    <hr style="margin-bottom: 1.75rem" />
    <footer>
      <Bio />
    </footer>
  </article>
  <nav>
    <ul style="display: flex; flex-wrap: wrap; justify-content: space-between; list-style: none; padding: 0">
      <li>
        {older && (
          <a href={`/${older.id}/`} rel="prev">
            ← {older.data.title}
          </a>
        )}
      </li>
      <li>
        {newer && (
          <a href={`/${newer.id}/`} rel="next">
            {newer.data.title} →
          </a>
        )}
      </li>
    </ul>
  </nav>
</Blog>
