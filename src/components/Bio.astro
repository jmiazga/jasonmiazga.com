---
import { Image } from "astro:assets"
import avatar from "../profile-pic.jpg"
import { site } from "../site"
---

<div style="display: flex; margin-bottom: 4.375rem">
  <Image
    src={avatar}
    alt={site.author.name}
    width={50}
    height={50}
    densities={[1, 2]}
    style="margin-right: 0.875rem; min-width: 50px; height: 50px; border-radius: 50%"
  />
  <p>
    Written by <strong>{site.author.name}</strong> {site.author.summary}{" "}
    <a href={`https://twitter.com/${site.social.twitter}`}>
      You should follow him on Twitter
    </a>
  </p>
</div>
